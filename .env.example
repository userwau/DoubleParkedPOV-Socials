# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional YouTube Data API v3 Key for @DoubleParkedPOV rich metadata polling
YOUTUBE_API_KEY=""

# X (Twitter) OAuth 2.0 Credentials for Automated Video Posting
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# TikTok Content Posting API OAuth 2.0 Credentials
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Instagram Reels (Meta Graph API) OAuth 2.0 Credentials
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
